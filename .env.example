# Datenbank-Zugang
# Lokal ohne Docker: MARIADB_HOST=127.0.0.1, USER=root oder eigener Setup
# Mit docker-compose: MARIADB_HOST=db, USER aus den Compose-Defaults
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=tuv_app
MARIADB_PASSWORD=tuv_app_pw
MARIADB_DATABASE=tuv_workflow

# Nur für docker-compose: root-Passwort für das MariaDB-Container-Setup.
# In Produktion unbedingt ändern und sicher aufbewahren (Backup-Restore-Key!)
MARIADB_ROOT_PASSWORD=please_change_me_in_production

# Express-API
API_PORT=8787

# NODE_ENV: "production" aktiviert den Fail-fast-Check unten.
# Docker Compose default ist production (Kunden-Deployment) — d. h. ohne
# gesetzten ADMIN_TOKEN verweigert die API absichtlich den Start.
# Nur fuer lokale Entwicklung (npm run dev:api) auf "development" setzen.
NODE_ENV=production

# Admin-Token: schützt /api/admin/reset und /api/admin/demo (DB-Wipe + Reseed).
# Leerer Wert + NODE_ENV=development = Dev-Modus (Endpunkte öffentlich, Warnung im Log).
# Leerer Wert + NODE_ENV=production  = Server verweigert den Start.
#
# In Produktion ZWINGEND setzen. Ohne Token kann jeder im LAN die Datenbank
# löschen. Mindestens 32 Zeichen, z. B.:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   bash/zsh:   openssl rand -hex 32
ADMIN_TOKEN=

# Benutzer-Login (Rollen: empfang / pruefer / chef).
# Leer = Default: an bei NODE_ENV=production, aus in development/CI.
# Explizit "true" oder "false" überschreibt den Default in beide Richtungen.
AUTH_ENABLED=

# Secret für die Signatur der Login-Tokens (HMAC-SHA256). Leer = Fallback
# auf ADMIN_TOKEN (in Produktion ohnehin Pflicht). Wenn AUTH aktiv ist und
# weder AUTH_SECRET noch ADMIN_TOKEN gesetzt sind, verweigert der Server
# den Start. Mindestens 32 Zeichen, Erzeugung wie beim ADMIN_TOKEN oben.
AUTH_SECRET=

# Passwort, mit dem die drei Default-Benutzer (empfang, MW, chef) beim
# ersten Start angelegt werden. Leer = Fallback "start123".
# Beim Kunden-Setup MÜSSEN die Passwörter danach geändert werden —
# der Wert greift nur beim Anlegen, bestehende Konten bleiben unberührt.
DEFAULT_USER_PASSWORT=

# CORS: zusätzliche erlaubte Origins (Komma-getrennt). localhost/127.0.0.1
# und RFC-1918 Private-LAN-Bereiche (10.x, 192.168.x, 172.16-31.x) sind
# immer erlaubt. Beispiel: ALLOWED_ORIGINS=https://werkstatt.example.de
ALLOWED_ORIGINS=

# Frontend → API
VITE_API_BASE_URL=/api
